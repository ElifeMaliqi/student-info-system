# AWS RDS PostgreSQL
DB_HOST=your-rds-host.eu-central-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_NAME=postgres
DB_PASSWORD=your-db-password
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Session signing (required in production)
JWT_SECRET=generate-a-long-random-secret

# App base URL (used in password reset links)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Resend (email delivery)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@your-domain.com

# Twilio (SMS delivery) — either naming convention works
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
# TWILIO_PHONE_NUMBER=+1234567890  ← alias accepted if you prefer this name
